{
    "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["src/**/*.js", "test/**/*.js", "biome.json"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 140
    },
    "javascript": {
        "globals": [],
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "arrowParentheses": "asNeeded",
            "trailingCommas": "es5",
            "operatorLinebreak": "before"
        }
    },
    "linter": {
        "rules": {
            "preset": "all",
            "nursery": "off",
            "a11y": "error",
            "complexity": "error",
            "correctness": "error",
            "performance": "error",
            "security": "error",
            "style": "error",
            "suspicious": "error"
        }
    },
    "overrides": [
        {
            "includes": ["**"],
            "linter": {
                "rules": {
                    "correctness": {
                        "useQwikValidLexicalScope": "off"
                    },
                    "style": {
                        "noTernary": "off",
                        "useNamingConvention": {
                            "level": "error",
                            "options": {
                                "conventions": [
                                    {
                                        "selector": {
                                            "kind": "objectLiteralProperty"
                                        },
                                        "formats": ["camelCase", "snake_case"]
                                    }
                                ]
                            }
                        },
                        "noExcessiveLinesPerFile": {
                            "level": "error",
                            "options": {
                                "maxLines": 200
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": [
                "src/logic/time.js",
                "src/logic/seek.js",
                "src/logic/hold.js",
                "src/logic/stream.js",
                "src/logic/item.js",
                "src/logic/watch.js",
                "src/logic/paint.js",
                "src/logic/words.js",
                "src/logic/config.js"
            ],
            "javascript": {
                "globals": [
                    "EXIT",
                    "Failure",
                    "isMissing",
                    "parseTime",
                    "SECONDS_PER_MINUTE",
                    "MICROSECONDS",
                    "formatTime",
                    "visibleLength",
                    "fitToWidth"
                ]
            },
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnusedVariables": {
                            "level": "error",
                            "options": {
                                "ignore": {
                                    "function": [
                                        "Failure",
                                        "livePosition",
                                        "clampTarget",
                                        "seekBase",
                                        "seekLanded",
                                        "seekOvertaken",
                                        "streamChange",
                                        "streakStart",
                                        "multiplierAt",
                                        "nextHoldTarget",
                                        "knobRate",
                                        "knobMultiplier",
                                        "expectedPlaying",
                                        "parseTime",
                                        "formatStatus",
                                        "parseIni",
                                        "resolveSettings",
                                        "formatSettings",
                                        "clock",
                                        "playerctlPosition",
                                        "mpcSeek",
                                        "playerctlFormat",
                                        "paintStatus",
                                        "paintJson",
                                        "orderRaw",
                                        "formatChapter",
                                        "humanNotes",
                                        "withHuman",
                                        "settingsTemplate",
                                        "describeChange",
                                        "fitToWidth",
                                        "parseColumns",
                                        "paintStatusParts"
                                    ],
                                    "variable": [
                                        "EXIT",
                                        "MILLISECONDS_PER_SECOND",
                                        "holdContinues",
                                        "releasedSince",
                                        "effectiveRate",
                                        "MICROSECONDS",
                                        "PERCENT",
                                        "SECONDS_PER_MINUTE",
                                        "alreadyThere",
                                        "paintUsage",
                                        "paintIni",
                                        "paintError",
                                        "visibleLength",
                                        "paintChange",
                                        "ESCAPE"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": [
                "src/system/mediaremote.js",
                "src/system/files.js",
                "src/system/terminal.js",
                "src/player.js",
                "src/system/configfile.js",
                "src/dialects/nowplaying-cli.js",
                "src/dialects/media-control-help.js",
                "src/dialects/media-control-read.js",
                "src/dialects/media-control.js",
                "src/dialects/shared.js",
                "src/dialects/playerctl.js",
                "src/dialects/mpc.js",
                "src/dialects/shpotify.js",
                "src/dialects/index.js",
                "src/usage.js",
                "src/watch.js",
                "src/cli.js"
            ],
            "javascript": {
                "globals": [
                    "$",
                    "ObjC",
                    "Application",
                    "Path",
                    "delay",
                    "MILLISECONDS_PER_SECOND",
                    "EXIT",
                    "Failure",
                    "isMissing",
                    "livePosition",
                    "effectiveRate",
                    "clampTarget",
                    "seekBase",
                    "seekLanded",
                    "seekOvertaken",
                    "streakStart",
                    "multiplierAt",
                    "holdContinues",
                    "releasedSince",
                    "nextHoldTarget",
                    "knobRate",
                    "knobMultiplier",
                    "expectedPlaying",
                    "parseTime",
                    "formatStatus",
                    "parseIni",
                    "resolveSettings",
                    "formatSettings",
                    "mediaRemote",
                    "player",
                    "configFile",
                    "asNowplayingCli",
                    "asMediaControl",
                    "mediaControlReads",
                    "streamChange",
                    "MC_HELP",
                    "mcFail",
                    "MICROS",
                    "COMMANDS",
                    "VERSION",
                    "KEY_PREFIX",
                    "now",
                    "locked",
                    "lastSeekFile",
                    "holdFile",
                    "releaseFiles",
                    "print",
                    "MICROSECONDS",
                    "PERCENT",
                    "playerctlFormat",
                    "playerctlPosition",
                    "mpcSeek",
                    "clock",
                    "PLAYERCTL_DECIMALS",
                    "MC_COMMANDS",
                    "asPlayerctl",
                    "asMpc",
                    "asShpotify",
                    "dialectFor",
                    "appName",
                    "refuse",
                    "unknown",
                    "move",
                    "alreadyThere",
                    "paintStatus",
                    "terminal",
                    "paintUsage",
                    "paintIni",
                    "paintJson",
                    "paintError",
                    "USAGE",
                    "orderRaw",
                    "formatChapter",
                    "humanNotes",
                    "setOrToggle",
                    "withHuman",
                    "settingsTemplate",
                    "describeChange",
                    "fitToWidth",
                    "parseColumns",
                    "visibleLength",
                    "paintChange",
                    "watching",
                    "formatChapter",
                    "ESCAPE"
                ]
            },
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnusedVariables": {
                            "level": "error",
                            "options": {
                                "ignore": {
                                    "function": ["run", "locked", "jsonFile", "dialectFor", "refuse", "unknown", "move", "setOrToggle"],
                                    "variable": [
                                        "mediaRemote",
                                        "player",
                                        "configFile",
                                        "asNowplayingCli",
                                        "asMediaControl",
                                        "mediaControlReads",
                                        "MC_HELP",
                                        "mcFail",
                                        "now",
                                        "lastSeekFile",
                                        "holdFile",
                                        "releaseFiles",
                                        "asPlayerctl",
                                        "asMpc",
                                        "asShpotify",
                                        "appName",
                                        "terminal",
                                        "USAGE",
                                        "watching"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["src/system/mediaremote.js", "src/dialects/media-control-read.js", "test/item.test.js", "test/watch.test.js"],
            "linter": {
                "rules": {
                    "security": {
                        "noSecrets": "off"
                    }
                }
            }
        },
        {
            "includes": ["test/**"],
            "javascript": {
                "globals": ["$", "ObjC", "Application", "Path", "delay", "GROUPS", "same", "failureOf"]
            },
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnusedVariables": {
                            "level": "error",
                            "options": {
                                "ignore": {
                                    "function": ["run", "failureOf", "same"]
                                }
                            }
                        }
                    },
                    "security": {
                        "noGlobalEval": "off"
                    },
                    "style": {
                        "noMagicNumbers": "off"
                    }
                }
            }
        },
        {
            "includes": ["test/edges.test.js", "test/edges-text.test.js"],
            "linter": {
                "rules": {
                    "security": {
                        "noSecrets": "off"
                    },
                    "style": {
                        "useNamingConvention": "off"
                    },
                    "complexity": {
                        "noExcessiveLinesPerFunction": "off"
                    }
                }
            }
        },
        {
            "includes": ["test/fake-mediaremote.js"],
            "javascript": {
                "globals": ["$", "ObjC", "effectiveRate", "MILLISECONDS_PER_SECOND"]
            },
            "linter": {
                "rules": {
                    "security": {
                        "noSecrets": "off"
                    },
                    "correctness": {
                        "noUnusedVariables": "off"
                    }
                }
            }
        }
    ]
}
