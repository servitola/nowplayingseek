{
    "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["src/**/*.js", "test/**/*.js", "biome.json"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 140
    },
    "javascript": {
        "globals": [],
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "arrowParentheses": "asNeeded",
            "trailingCommas": "es5",
            "operatorLinebreak": "before"
        }
    },
    "linter": {
        "rules": {
            "preset": "all",
            "nursery": "off",
            "a11y": "error",
            "complexity": "error",
            "correctness": "error",
            "performance": "error",
            "security": "error",
            "style": "error",
            "suspicious": "error"
        }
    },
    "overrides": [
        {
            "includes": ["**"],
            "linter": {
                "rules": {
                    "correctness": {
                        "useQwikValidLexicalScope": "off"
                    },
                    "style": {
                        "noTernary": "off",
                        "useNamingConvention": {
                            "level": "error",
                            "options": {
                                "conventions": [
                                    {
                                        "selector": {
                                            "kind": "objectLiteralProperty"
                                        },
                                        "formats": ["camelCase", "snake_case"]
                                    }
                                ]
                            }
                        },
                        "noExcessiveLinesPerFile": {
                            "level": "error",
                            "options": {
                                "maxLines": 200
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["src/core.js", "src/pattern.js", "src/config.js"],
            "javascript": {
                "globals": ["EXIT", "Failure", "isMissing", "parseTime", "parsePattern"]
            },
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnusedVariables": {
                            "level": "error",
                            "options": {
                                "ignore": {
                                    "function": [
                                        "Failure",
                                        "livePosition",
                                        "clampTarget",
                                        "seekBase",
                                        "seekLanded",
                                        "streakStart",
                                        "multiplierAt",
                                        "nextHoldTarget",
                                        "expectedPlaying",
                                        "parseTime",
                                        "parsePattern",
                                        "formatStatus",
                                        "parseIni",
                                        "resolveSettings",
                                        "formatSettings"
                                    ],
                                    "variable": ["EXIT", "MILLISECONDS_PER_SECOND", "holdContinues", "releasedSince"]
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["src/mediaremote.js", "src/player.js", "src/configfile.js", "src/cli.js"],
            "javascript": {
                "globals": [
                    "$",
                    "ObjC",
                    "Application",
                    "Path",
                    "delay",
                    "MILLISECONDS_PER_SECOND",
                    "EXIT",
                    "Failure",
                    "isMissing",
                    "livePosition",
                    "clampTarget",
                    "seekBase",
                    "seekLanded",
                    "streakStart",
                    "multiplierAt",
                    "holdContinues",
                    "releasedSince",
                    "nextHoldTarget",
                    "expectedPlaying",
                    "parseTime",
                    "formatStatus",
                    "parseIni",
                    "resolveSettings",
                    "formatSettings",
                    "mediaRemote",
                    "player",
                    "configFile"
                ]
            },
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnusedVariables": {
                            "level": "error",
                            "options": {
                                "ignore": {
                                    "function": ["run"],
                                    "variable": ["mediaRemote", "player", "configFile"]
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["src/mediaremote.js"],
            "linter": {
                "rules": {
                    "security": {
                        "noSecrets": "off"
                    }
                }
            }
        },
        {
            "includes": ["test/**"],
            "javascript": {
                "globals": ["$", "ObjC", "Application", "Path", "delay", "GROUPS", "same", "failureOf"]
            },
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnusedVariables": {
                            "level": "error",
                            "options": {
                                "ignore": {
                                    "function": ["run", "failureOf", "same"]
                                }
                            }
                        }
                    },
                    "security": {
                        "noGlobalEval": "off"
                    },
                    "style": {
                        "noMagicNumbers": "off"
                    }
                }
            }
        }
    ]
}
